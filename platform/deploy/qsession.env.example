# Plantilla documental. Los valores secretos se generan al publicar y nunca se
# guardan en el repositorio.
NODE_ENV=production
QSESSION_PORT=8090
QSESSION_PUBLIC_URL=https://qsession.org
QSESSION_PUBLIC_ROOMS_ENABLED=true
QSESSION_AUTH_PEPPER=reemplazar_con_secreto_estable
QSESSION_ROOM_SECRET=reemplazar_con_otro_secreto_estable
# Recuperación de cuentas por correo. Verifica qsession.org en Resend y usa un
# remitente exclusivo; la clave nunca se expone al navegador ni a las apps.
QSESSION_RESEND_API_KEY=re_reemplazar
QSESSION_RECOVERY_FROM_EMAIL=Q Session <acceso@correo.qsession.org>
# Notificaciones Android (Firebase Cloud Messaging). Usa solo una de estas dos
# opciones y conserva la credencial exclusivamente en el servidor. Nunca copies
# la clave privada al navegador, al APK/AAB ni al repositorio.
# compose.yml monta private/qsession-firebase-service-account.json en:
# QSESSION_FIREBASE_SERVICE_ACCOUNT_FILE=/run/secrets/qsession-firebase-service-account.json
# QSESSION_FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"q-session","private_key_id":"REPLACE_WITH_KEY_ID","private_key":"REPLACE_WITH_FIREBASE_PRIVATE_KEY","client_email":"firebase-adminsdk-fbsvc@q-session.iam.gserviceaccount.com"}
# PostgreSQL conserva el chat de alta concurrencia. Durante la migración, el
# resto del producto puede continuar leyendo el volumen compatible de la beta.
QSESSION_STORAGE_DRIVER=hybrid
QSESSION_DATA_FILE=/data/qsession-state.json
QSESSION_PROFILE_MEDIA_DIR=/data/profile-media
QSESSION_PRIVATE_MEDIA_DIR=/data/private-media
QSESSION_PROMOTION_MEDIA_DIR=/data/promotion-media
QSESSION_ORIGINAL_MUSIC_DIR=/data/original-music
QSESSION_ANALYTICS_DATA_FILE=/data/qsession-analytics.ndjson
POSTGRES_DB=qsession
POSTGRES_USER=qsession
POSTGRES_PASSWORD=reemplazar_con_secreto_estable
QSESSION_DATABASE_URL=postgresql://qsession:reemplazar_con_secreto_estable@127.0.0.1:5432/qsession
QSESSION_DATABASE_POOL_SIZE=20
QSESSION_REDIS_URL=redis://127.0.0.1:6379
QSESSION_ROOM_TARGET_CAPACITY=5000
QSESSION_REALTIME_MAX_CONNECTIONS=6000
QSESSION_DJ_CAMERA_LIMIT=3
# Respaldo para un proveedor HLS externo. Usa {roomCode} como marcador; la ruta
# S3/CDN que aparece debajo tiene prioridad cuando sus credenciales están completas.
# QSESSION_BROADCAST_PLAYBACK_URL_TEMPLATE=https://video.example/live/{roomCode}/manifest.m3u8
# LiveKit Egress extrae solamente al DJ principal. Cloudflare R2 es la ruta
# económica principal; el volumen local queda como respaldo de transición.
QSESSION_BROADCAST_PROVIDER=cloudflare-r2-hls
QSESSION_EDGE_MEDIA_DIR=/data/edge-live
QSESSION_EGRESS_OUTPUT_DIRECTORY=/out/edge-live
QSESSION_EDGE_PLAYBACK_PATH_PREFIX=edge-live
# Variables heredadas para instalaciones anteriores.
QSESSION_EDGE_PLAYBACK_MANIFEST_SUFFIX=
# Cloudflare R2. Las credenciales deben limitarse exclusivamente a qsession-live.
QSESSION_BROADCAST_STORAGE_ENDPOINT=
QSESSION_BROADCAST_STORAGE_BUCKET=qsession-live
QSESSION_BROADCAST_STORAGE_ACCESS_KEY=reemplazar
QSESSION_BROADCAST_STORAGE_SECRET_KEY=reemplazar
QSESSION_BROADCAST_STORAGE_REGION=us-east-1
QSESSION_BROADCAST_FORCE_PATH_STYLE=true
QSESSION_BROADCAST_STORAGE_PLAYBACK_BASE_URL=https://live.qsession.org
QSESSION_BROADCAST_STORAGE_PLAYBACK_PATH_PREFIX=
QSESSION_BROADCAST_STORAGE_PLAYBACK_MANIFEST_SUFFIX=
# Emergencia: origen directo, sin CDN de pago. WebRTC sigue siendo el último respaldo.
QSESSION_BROADCAST_LOCAL_PLAYBACK_BASE_URL=https://qsession.org
QSESSION_BROADCAST_LOCAL_PLAYBACK_PATH_PREFIX=edge-live
QSESSION_BROADCAST_LOCAL_PLAYBACK_MANIFEST_SUFFIX=
QSESSION_EDGE_PLAYBACK_BASE_URL=https://live.qsession.org
# Segmentos de 6 s reducen solicitudes; 1,6 Mbps conserva 720p con menor consumo móvil.
QSESSION_HLS_SEGMENT_SECONDS=6
QSESSION_HLS_VIDEO_BITRATE=1600000
QSESSION_HLS_AUDIO_BITRATE=128000
# QSESSION_OBJECT_STORAGE_ENDPOINT=https://objeto.ejemplo
# QSESSION_OBJECT_STORAGE_BUCKET=qsession-media
# QSESSION_OBJECT_STORAGE_ACCESS_KEY=reemplazar
# QSESSION_OBJECT_STORAGE_SECRET_KEY=reemplazar
# Carga directa opcional: el token sólo necesita permiso Stream Write y nunca se
# envía a web, Android ni Windows.
# QSESSION_STREAM_ACCOUNT_ID=reemplazar
# QSESSION_STREAM_API_TOKEN=reemplazar

# Panel privado https://qsession.org/admin. La contraseña se almacena únicamente
# como hash scrypt; nunca escribas la contraseña real en este archivo.
QSESSION_ADMIN_USERNAME=reemplazar_con_usuario
QSESSION_ADMIN_PASSWORD_HASH=reemplazar_con_hash_scrypt
QSESSION_ADMIN_SESSION_SECRET=reemplazar_con_secreto_aleatorio
QSESSION_ADMIN_RECOVERY_CODE_HASH=reemplazar_con_hash_scrypt
QSESSION_ADMIN_CREDENTIAL_FILE=/data/qsession-admin-credential.json
QSESSION_ANALYTICS_SECRET=reemplazar_con_secreto_aleatorio

# Cobros de salas. Mantén QSESSION_BILLING_ENFORCED=false hasta terminar las
# pruebas Sandbox y confirmar que el webhook acredita bonos correctamente.
QSESSION_BILLING_ENFORCED=false
QSESSION_BILLING_DATA_FILE=/data/qsession-billing.json
QSESSION_WOMPI_PUBLIC_KEY=pub_test_reemplazar
QSESSION_WOMPI_INTEGRITY_SECRET=test_integrity_reemplazar
QSESSION_WOMPI_EVENTS_SECRET=test_events_reemplazar
QSESSION_WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
# Configura en Wompi Sandbox: https://qsession.org/api/webhooks/wompi

# Entrada pública global exclusiva de Q Session.
LIVEKIT_URL=http://127.0.0.1:7880
LIVEKIT_PUBLIC_URL=wss://media.qsession.org
LIVEKIT_API_KEY=reemplazar
LIVEKIT_API_SECRET=reemplazar

# La biblioteca propia permanece activa. Las fuentes musicales externas están retiradas.
QSESSION_MUSIC_ENABLED=true
QSESSION_EXTERNAL_MUSIC_ENABLED=false
QSESSION_AUDIUS_ENABLED=false
QSESSION_AUDIUS_API_KEY=
# Administration-only audio ceiling. WebRTC adapts down for network conditions.
QSESSION_BROADCAST_AUDIO_BITRATE=320000
# Optional: enables deeper natural-language interpretation for qDJ. Without it,
# QSession uses its built-in catalog-aware semantic interpreter.
QSESSION_QDJ_SEMANTIC_AI_ENABLED=false
QSESSION_QDJ_INTERPRET_MODEL=gpt-5-mini
