# Perfil de ingeniería para una audiencia objetivo, NO capacidad certificada.
# Aplicar sólo tras pruebas y confirmación de capacidad, cuotas y presupuesto CDN.
QSESSION_AUDIENCE_MODE=interactive
QSESSION_CDN_ONLY_PAUSED=false
QSESSION_CDN_ONLY_ROOM=
QSESSION_MASS_BROADCAST_READINESS_FILE=/run/qsession/mass-broadcast-readiness.json
QSESSION_BROADCAST_AUDIENCE_TARGET=500000
# Bits por segundo. edge-broadcast convierte a kbit/s en la API de LiveKit.
QSESSION_HLS_VIDEO_BITRATE=1800000
QSESSION_HLS_AUDIO_BITRATE=320000
QSESSION_HLS_SEGMENT_SECONDS=6
# Mantener credenciales existentes de almacenamiento y URL HTTPS de la CDN.
# Este archivo no las proporciona ni activa recursos de pago.
