<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>QSession.Host</RootNamespace>
    <AssemblyName>QSession.Host</AssemblyName>
    <Product>Q Session Desktop</Product>
    <Description>Transmisión nativa y estable para anfitriones de Q Session.</Description>
    <Version>0.4.15</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishTrimmed>false</PublishTrimmed>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\qsession.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(QSessionSelfInstaller)' == 'true'">
    <DefineConstants>$(DefineConstants);QSESSION_SELF_INSTALLER</DefineConstants>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3719.77" />
    <Resource Include="Assets\qsession.ico" />
    <Resource Include="..\..\..\platform\public\brand\qsession-icon-master.png"
              Link="Assets\qsession.png" />
    <Resource Include="Assets\qsession-world-network.png"
              Link="Assets\world-network.png" />
    <Content Include="..\..\native-media\build\ninja\QSession.Audio.dll"
             Link="QSession.Audio.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\native-media\build\ninja\livekit.dll"
             Link="livekit.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\native-media\build\ninja\livekit_ffi.dll"
             Link="livekit_ffi.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\platform\public\tab-capture.html"
             Link="Capture\tab-capture.html"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\platform\public\tab-capture.css"
             Link="Capture\tab-capture.css"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\platform\public\tab-capture.js"
             Link="Capture\tab-capture.js"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\platform\public\vendor\livekit-client.umd.js"
             Link="Capture\vendor\livekit-client.umd.js"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\platform\public\brand\qsession-icon-master.png"
             Link="Capture\brand\qsession-icon-master.png"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
