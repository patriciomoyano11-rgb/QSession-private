<Window x:Class="QSession.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Q Session Desktop"
        Icon="/QSession.Host;component/Assets/qsession.ico"
        Width="1280" Height="840" MinWidth="1060" MinHeight="720"
        Background="{StaticResource Canvas}"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Brand rail -->
        <Border Grid.Column="0" Background="#E4F0EF" BorderBrush="#CADDDD" BorderThickness="0,0,1,0" Padding="23,26,20,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="58" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="48" Height="48" Background="{StaticResource Navy}" CornerRadius="14">
                        <Image Source="/QSession.Host;component/Assets/qsession.png" Width="39" Height="39" Stretch="Uniform" />
                    </Border>
                    <StackPanel Margin="12,2,0,0">
                        <TextBlock Text="Q SESSION" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="DESKTOP" Margin="0,2,0,0" Foreground="#397986" FontSize="9" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="NUEVA TRANSMISIÓN" Foreground="#3D7F88" FontSize="10" FontWeight="Bold" />
                    <Border Margin="0,13,0,0" Padding="13,12" Background="{StaticResource Navy}" CornerRadius="13">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="31" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="25" Height="25" Background="{StaticResource Aqua}" CornerRadius="8"><TextBlock Text="01" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9" FontWeight="Bold" /></Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Sala y acceso" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="Nombre y privacidad" Foreground="#AFC9D3" FontSize="9" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Margin="0,7,0,0" Padding="13,12" Background="#F3F8F7" BorderBrush="#D1E2E1" BorderThickness="1" CornerRadius="13">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="31" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="25" Height="25" Background="#D8ECEA" CornerRadius="8"><TextBlock Text="02" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9" FontWeight="Bold" Foreground="#367C85" /></Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Fuente audiovisual" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="Audio y cámara" Foreground="{StaticResource InkSoft}" FontSize="9" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Margin="0,7,0,0" Padding="13,12" Background="#F3F8F7" BorderBrush="#D1E2E1" BorderThickness="1" CornerRadius="13">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="31" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="25" Height="25" Background="#D8ECEA" CornerRadius="8"><TextBlock Text="03" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9" FontWeight="Bold" Foreground="#367C85" /></Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Participación" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="Funciones de la sala" Foreground="{StaticResource InkSoft}" FontSize="9" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Margin="0,7,0,0" Padding="13,12" Background="#F3F8F7" BorderBrush="#D1E2E1" BorderThickness="1" CornerRadius="13">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="31" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="25" Height="25" Background="#D8ECEA" CornerRadius="8"><TextBlock Text="04" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9" FontWeight="Bold" Foreground="#367C85" /></Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Señal en vivo" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="Control y enlace" Foreground="{StaticResource InkSoft}" FontSize="9" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <Border Grid.Row="4" Background="#D3E7E6" CornerRadius="15" Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Aqua}" Margin="0,0,7,0" />
                            <TextBlock Text="TRANSMISIÓN NATIVA" Foreground="#287A83" FontSize="9" FontWeight="Bold" />
                        </StackPanel>
                        <TextBlock Text="Hecha para permanecer en vivo" Margin="0,7,0,0" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="Puedes minimizar Q Session y continuar usando tu computador." Margin="0,5,0,0" Foreground="#567787" FontSize="10" LineHeight="15" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Product workspace -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="70" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FFFEFB" BorderBrush="#D9E3E2" BorderThickness="0,0,0,1" Padding="30,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Estudio de transmisión" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Crea la sesión, comparte y conecta." Foreground="{StaticResource InkSoft}" FontSize="10" Margin="0,2,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Padding="12,7" Margin="0,0,10,0" Background="{StaticResource AquaSoft}" CornerRadius="16" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ServerDot" Width="8" Height="8" Fill="#7D96A3" Margin="0,0,8,0" />
                            <TextBlock x:Name="ServerStatus" Text="Comprobando qsession.org…" Foreground="#287A83" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Padding="12,7" Background="#EEF1F2" CornerRadius="16" VerticalAlignment="Center">
                        <TextBlock Text="ANFITRIÓN · BETA" Foreground="#506B7B" FontSize="10" FontWeight="Bold" />
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="30,26,30,40">
                    <!-- Commercial hero -->
                    <Border Height="172" CornerRadius="27" ClipToBounds="True" Effect="{StaticResource CardShadow}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0C294C" Offset="0" />
                                <GradientStop Color="#123A59" Offset="0.62" />
                                <GradientStop Color="#1F6272" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Image Source="/QSession.Host;component/Assets/world-network.png" Stretch="UniformToFill" Opacity="0.16" />
                            <Ellipse Width="260" Height="260" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-154,-45,0" Stroke="#67CDD1" StrokeThickness="1" Opacity="0.28" />
                            <Ellipse Width="170" Height="170" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-96,6,0" Stroke="#8CE4DC" StrokeThickness="1" Opacity="0.38" />
                            <Grid Margin="37,27,30,27">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Q SESSION · EN VIVO" Foreground="{StaticResource Aqua}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Text="Tu sala. Tu señal. En vivo." Margin="0,7,0,0" Foreground="White" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="33" FontWeight="SemiBold" />
                                    <TextBlock Text="Una experiencia profesional para música, clases, conferencias y encuentros privados." Margin="0,8,0,0" Foreground="#C6D9E0" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Border Padding="13,9" Background="#2DFFFFFF" CornerRadius="13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="01" Foreground="{StaticResource Aqua}" FontSize="10" FontWeight="Bold" /><TextBlock Grid.Column="1" Text="DEFINE LA EXPERIENCIA" Foreground="White" FontSize="10" FontWeight="SemiBold" /></Grid></Border>
                                    <Border Margin="0,7,0,0" Padding="13,9" Background="#20FFFFFF" CornerRadius="13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="02" Foreground="{StaticResource Aqua}" FontSize="10" FontWeight="Bold" /><TextBlock Grid.Column="1" Text="ELIGE TU SEÑAL" Foreground="White" FontSize="10" FontWeight="SemiBold" /></Grid></Border>
                                    <Border Margin="0,7,0,0" Padding="13,9" Background="#20FFFFFF" CornerRadius="13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="03" Foreground="{StaticResource Aqua}" FontSize="10" FontWeight="Bold" /><TextBlock Grid.Column="1" Text="COMPARTE Y CONECTA" Foreground="White" FontSize="10" FontWeight="SemiBold" /></Grid></Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="0.92*" /></Grid.ColumnDefinitions>

                        <!-- Session configuration -->
                        <StackPanel Grid.Column="0">
                            <Border Background="{StaticResource Panel}" BorderBrush="#DCE7E5" BorderThickness="1" CornerRadius="23" Padding="25" Effect="{StaticResource CardShadow}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Width="39" Height="39" Background="{StaticResource AquaSoft}" CornerRadius="12"><TextBlock Text="01" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#2C8189" FontSize="11" FontWeight="Bold" /></Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Sala y acceso" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="20" FontWeight="SemiBold" />
                                            <TextBlock Text="Ponle identidad a la experiencia que vas a compartir." Foreground="{StaticResource InkSoft}" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="NOMBRE DE LA SESIÓN" Foreground="#3E7580" FontSize="9" FontWeight="Bold" Margin="0,20,0,7" />
                                    <TextBox x:Name="RoomNameBox" Text="Mi sesión en vivo" />

                                    <Grid Margin="0,13,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="13" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="ANFITRIÓN" Foreground="#3E7580" FontSize="9" FontWeight="Bold" Margin="0,0,0,7" />
                                            <TextBox x:Name="HostNameBox" Text="Anfitrión" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="TIPO DE SESIÓN" Foreground="#3E7580" FontSize="9" FontWeight="Bold" Margin="0,0,0,7" />
                                            <ComboBox x:Name="RoomTypePicker" SelectionChanged="RoomTypePicker_SelectionChanged" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Margin="0,9,0,0" Padding="11,8" Background="#F1F7F5" CornerRadius="10">
                                        <TextBlock x:Name="RoomTypeDescription" TextWrapping="Wrap" Foreground="{StaticResource InkSoft}" FontSize="10" />
                                    </Border>

                                    <TextBlock Text="PRIVACIDAD DE LA SALA" Foreground="#3E7580" FontSize="9" FontWeight="Bold" Margin="0,18,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="11" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <RadioButton x:Name="PublicRoomRadio" GroupName="Visibility" IsChecked="True" Style="{StaticResource ChoiceCard}">
                                            <StackPanel>
                                                <TextBlock Text="Pública" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="Todos pueden verla" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Opacity="0.68" FontSize="10" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="PrivateRoomRadio" Grid.Column="2" GroupName="Visibility" Style="{StaticResource ChoiceCard}">
                                            <StackPanel>
                                                <TextBlock Text="Privada" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="Solo con acceso compartido" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Opacity="0.68" FontSize="10" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </RadioButton>
                                    </Grid>

                                    <Border Margin="0,18,0,0" Padding="16,14" Background="#F2F8F6" CornerRadius="14">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="03 · PARTICIPACIÓN" Foreground="#2D8189" FontSize="9" FontWeight="Bold" />
                                                    <TextBlock Text="Activa solo lo que necesita esta sala" Margin="0,4,0,0" FontSize="12" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="CONTRASEÑA · OPCIONAL" Foreground="#3E7580" FontSize="8" FontWeight="Bold" Margin="0,0,0,5" />
                                                    <PasswordBox x:Name="RoomPasswordBox" MinHeight="38" Padding="11,7" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <CheckBox x:Name="PublicChatCheck" Content="Chat público" />
                                                    <CheckBox x:Name="GuestCamerasCheck" Content="Cámaras de invitados" />
                                                    <CheckBox x:Name="SocialProfilesCheck" Content="Perfiles sociales" Checked="SocialProfilesCheck_Changed" Unchecked="SocialProfilesCheck_Changed" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <CheckBox x:Name="MatchmakingCheck" Content="Matchmaking" />
                                                    <CheckBox x:Name="ProfileGiftsCheck" Content="Tips y detalles" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Button x:Name="StartBroadcastButton" Content="Crear sala e iniciar transmisión  →" Style="{StaticResource PrimaryButton}" Margin="0,19,0,0" Click="StartBroadcastButton_Click" />
                                    <Button x:Name="RecoverSessionButton" Content="Recuperar la última sala" Style="{StaticResource SecondaryButton}" Margin="0,9,0,0" Visibility="Collapsed" Click="RecoverSessionButton_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Signal and live control -->
                        <StackPanel Grid.Column="2">
                            <Border Background="#E4F1EF" BorderBrush="#CDE1DF" BorderThickness="1" CornerRadius="23" Padding="23" Effect="{StaticResource CardShadow}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" Background="{StaticResource Navy}" CornerRadius="12"><TextBlock Text="02" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Aqua}" FontSize="10" FontWeight="Bold" /></Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Fuente audiovisual" FontSize="18" FontWeight="SemiBold" />
                                            <TextBlock Text="Elige exactamente qué recibirá tu audiencia." Foreground="{StaticResource InkSoft}" FontSize="10" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,17,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="FUENTE DE AUDIO" Foreground="#3E7580" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                                        <Button x:Name="RefreshAudioButton" Grid.Column="1" Content="Actualizar" Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="10" Click="RefreshAudioButton_Click" />
                                    </Grid>
                                    <ComboBox x:Name="AudioSourcePicker" Margin="0,7,0,8" SelectionChanged="AudioSourcePicker_SelectionChanged" />
                                    <ComboBox x:Name="DevicePicker" />
                                    <TextBlock x:Name="AudioSourceNote" Text="Audio digital directo, sin depender del volumen de los altavoces." TextWrapping="Wrap" Foreground="#557887" FontSize="9" Margin="0,8,0,0" />

                                    <Border x:Name="BrowserCaptureNote" Margin="0,12,0,0" Padding="13" Background="#FFFEFB" BorderBrush="#BBDDDC" BorderThickness="1" CornerRadius="13" Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="PESTAÑA DE CHROME" Foreground="#2D8189" FontSize="8" FontWeight="Bold" />
                                                <TextBlock Text="Chrome mostrará el selector sólo al confirmar. Después, la captura quedará oculta y el audio seguirá activo en segundo plano." Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#557887" FontSize="9" LineHeight="14" />
                                            </StackPanel>
                                            <Button x:Name="OpenChromeCaptureButton" Grid.Column="1" Content="Mostrar selector" Style="{StaticResource SecondaryButton}" Padding="10,7" FontSize="9" IsEnabled="False" Click="OpenChromeCaptureButton_Click" />
                                        </Grid>
                                    </Border>

                                    <Border Margin="0,15,0,0" Padding="14,11" Background="#CCFFFFFF" CornerRadius="13">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <CheckBox x:Name="PublishCameraCheck" Content="Transmitir también mi cámara" Checked="PublishCameraCheck_Changed" Unchecked="PublishCameraCheck_Changed" VerticalAlignment="Center" />
                                                <Button x:Name="RefreshCameraButton" Grid.Column="1" Content="Actualizar" Style="{StaticResource SecondaryButton}" Padding="9,5" FontSize="9" Click="RefreshCameraButton_Click" />
                                            </Grid>
                                            <ComboBox x:Name="CameraPicker" Margin="0,8,0,0" IsEnabled="False" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,17,0,0" CornerRadius="23" ClipToBounds="True" Effect="{StaticResource StrongShadow}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#071B33" Offset="0" />
                                        <GradientStop Color="#123958" Offset="0.7" />
                                        <GradientStop Color="#1D5869" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Ellipse Width="250" Height="250" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-120,-100,0" Stroke="#67CDD1" StrokeThickness="1" Opacity="0.18" />
                                    <StackPanel Margin="23">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="04 · CONTROL DE SEÑAL" Foreground="{StaticResource Aqua}" FontSize="9" FontWeight="Bold" />
                                                <TextBlock x:Name="LiveTitle" Text="Tu señal aparecerá aquí" Foreground="White" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0" />
                                            </StackPanel>
                                            <Border x:Name="ConnectionBadge" Grid.Column="1" Background="#284A68" CornerRadius="14" Padding="10,6" VerticalAlignment="Top">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource Aqua}" Margin="0,0,6,0" />
                                                    <TextBlock x:Name="ConnectionBadgeText" Text="LISTO" Foreground="#D8EBEF" FontSize="9" FontWeight="Bold" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <TextBlock x:Name="LiveStatus" Text="Configura la sala y selecciona el audio. Q Session cuidará la reconexión." Foreground="#B8CFD8" FontSize="10" TextWrapping="Wrap" LineHeight="16" Margin="0,8,0,0" />

                                        <Border Margin="0,15,0,0" Background="#8A061B32" BorderBrush="#315874" BorderThickness="1" CornerRadius="16" Padding="16">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="CÓDIGO DE LA SALA" Foreground="#8EC7CE" FontSize="8" FontWeight="Bold" />
                                                    <TextBlock x:Name="RoomCodeText" Text="—— ——" Foreground="White" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="28" FontWeight="SemiBold" Margin="0,3,0,0" />
                                                    <TextBlock x:Name="JoinLinkText" Text="El enlace aparecerá al crear la sala" Foreground="#91ADBA" FontSize="9" TextWrapping="Wrap" Margin="0,3,10,0" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Width="63" Height="63" Background="#172F4B" BorderBrush="#3A647B" BorderThickness="1" CornerRadius="18" VerticalAlignment="Center">
                                                    <Image Source="/QSession.Host;component/Assets/qsession.png" Width="45" Height="45" Stretch="Uniform" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Button x:Name="CopyCodeButton" Content="Copiar código" Style="{StaticResource SecondaryButton}" Padding="9,7" FontSize="10" IsEnabled="False" Click="CopyCodeButton_Click" />
                                            <Button x:Name="CopyLinkButton" Grid.Column="2" Content="Copiar enlace" Style="{StaticResource SecondaryButton}" Padding="9,7" FontSize="10" IsEnabled="False" Click="CopyLinkButton_Click" />
                                        </Grid>

                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="0.75*" /></Grid.ColumnDefinitions>
                                            <Border Background="#193D5B" CornerRadius="12" Padding="12">
                                                <StackPanel>
                                                    <TextBlock Text="NIVEL DE AUDIO · L / R" Foreground="#91AFBB" FontSize="8" FontWeight="Bold" />
                                                    <ProgressBar x:Name="LeftMeter" Height="6" Maximum="1" Margin="0,9,0,5" />
                                                    <ProgressBar x:Name="RightMeter" Height="6" Maximum="1" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Background="#193D5B" CornerRadius="12" Padding="12">
                                                <StackPanel>
                                                    <TextBlock Text="EN VIVO" Foreground="#91AFBB" FontSize="8" FontWeight="Bold" />
                                                    <TextBlock x:Name="ElapsedText" Text="00:00:00" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="DroppedText" Text="Paquetes descartados: 0" Foreground="#88A8B5" FontSize="8" />
                                            <TextBlock x:Name="CameraStatusText" Grid.Column="1" Text="Cámara: desactivada" Foreground="#88A8B5" FontSize="8" TextAlignment="Right" />
                                        </Grid>

                                        <Button x:Name="RetryNowButton" Content="Reconectar ahora" Style="{StaticResource SecondaryButton}" Margin="0,12,0,0" Padding="10,8" Visibility="Collapsed" Click="RetryNowButton_Click" />
                                        <Button x:Name="StopBroadcastButton" Content="Finalizar transmisión" Style="{StaticResource PrimaryButton}" Background="#E99D94" Margin="0,8,0,0" Padding="10,10" IsEnabled="False" Click="StopBroadcastButton_Click" />
                                        <TextBlock Text="Minimizar la ventana no interrumpe la transmisión." Foreground="#789AA8" FontSize="8" TextAlignment="Center" Margin="0,9,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
